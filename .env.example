# Default: Docker prepares Ollama automatically; no external API key is needed.
# To use external models, replace the empty values with your actual configuration:
# MODEL_CONFIG_JSON='[{"provider":"openai","model":"your-model-id","base_url":"https://your-service/v1","api_key":"YOUR_KEY"}]'
# PRIMARY_MODEL=your-model-id
MODEL_CONFIG_JSON=
PRIMARY_MODEL=
MODEL_TIMEOUT_SECONDS=35
MODEL_TEMPERATURE=0.3
STT_PROVIDER=local
STT_MODEL=whisper-1
WHISPER_MODEL=tiny
TTS_ENGLISH_VOICE=en-US-AriaNeural
TTS_RATE=-5%
# Internal streaming ASR segment endpoint; does not submit conversational turns.
CALL_END_SILENCE=0.65
# Legacy protocol 2 / detector-unavailable fallback. New calls use adaptive endpoints.
CALL_TURN_END_SILENCE_MS=3000
CALL_VAD_THRESHOLD=0.6
CALL_VAD_NEG_THRESHOLD=0.35
CALL_BARGE_IN_MIN_SPEECH_MS=300
CALL_BARGE_IN_NO_TEXT_MS=800
CALL_FINAL_ASR_MODEL=small.en
CALL_FINAL_ASR_WAIT_MS=2500
# All LLM stages use PRIMARY_MODEL: input interpretation, routing, Wiki,
# checks, conversation and answer parts. No separate small-model overrides
# and no automatic fallback to another configured model.
# Primary-model input interpretation has a minimum 12-second budget.
CALL_TRANSCRIPT_TIMEOUT_MS=12000
# Capture/ASR, interpretation, routing, tools and speech have separate bounds;
# actual end-to-end latency is still measured from the original voice handoff.
# Local build / Docker first start downloads reusable voice models; set 0 for text-only.
DUET_PREPARE_VOICE=1
# Optional: override model directory. In Docker this must be a CONTAINER path.
# Default: /app/data/models/voice in Docker; backend/data/models/voice locally.
TALKER_USER_ID=talker-001
HINTER_USER_ID=hinter-001
DUET_PORT=8818
# Optional regional package mirror if the default Debian download is slow:
# DEBIAN_MIRROR=https://mirrors.ustc.edu.cn
# For a local-only deployment, leave MODEL_CONFIG_JSON and PRIMARY_MODEL empty.
OLLAMA_MODEL=qwen2.5:3b

# Optional official DeepSeek primary. The verified official model ID is
# deepseek-flash; it is prepended to MODEL_CONFIG_JSON when its key is set.
DEEPSEEK_OFFICIAL_API_KEY=
DEEPSEEK_OFFICIAL_MODEL=deepseek-flash
DEEPSEEK_OFFICIAL_BASE_URL=https://api.deepseek.com/v1
# Optional tool config. Docker creates /app/data/agent-tools.json on first start.
# Paths in Docker must refer to container paths, not host paths.
# Optional when web_search_provider is brave; Bing RSS requires no key.
# BRAVE_SEARCH_API_KEY=YOUR_BRAVE_KEY
# Embedded DeerFlow uses the same search adapter. Optional explicit provider:
# DUET_WEB_SEARCH_PROVIDER=bing
# SEARXNG_URL=https://your-search-host.example

# Personal employee / MySQL deployment (secret values generated by setup-employee.py)
MYSQL_IMAGE=mysql:8.4.7@sha256:0426ec38c7a10aa45ba383887df7878f74ee70e2fd589c7b69207f3577901903
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13316
MYSQL_DATABASE=duet
MYSQL_USER=duet
MYSQL_PASSWORD_FILE=.runtime/secrets/mysql-password
# Initial administrator login and password are entered interactively on first deployment.
# They are stored only in ignored .runtime/bootstrap/bootstrap-admin.json (0600).
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai
# For HTTPS, set SESSION_COOKIE_SECURE=true and APP_ORIGIN=https://your-host.
# Optional CPU and speech cache settings; Docker defaults are persistent.
OLLAMA_CPUS=4
OLLAMA_NUM_THREAD=4
# WHISPER_MODEL_CACHE=/absolute/model/cache
# Local speech fallback: automatic language detection; cloud pricing/plan in docs/voice-api-comparison-20261025.md
WHISPER_BEAM_SIZE=1
VOICE_END_SILENCE_MS=1200

# Official Volcengine/Doubao Voice: a single NEW console API Key enables ASR + TTS.
# Alias VOLCENGINE_APP_KEY is accepted. This is NOT a cloud IAM AccessKey.
# Keep the actual value in the local .env, never in frontend variables or Git.
# Optional label for identifying the key; not an authentication parameter.
VOLCENGINE_API_KEY_NAME=
VOLCENGINE_API_KEY=
VOICE_ASR_PROVIDER=auto
VOICE_TTS_PROVIDER=auto
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_END_WINDOW_MS=800
# Empty: default Chinese/English model; choose supported language per official ASR docs.
VOLCENGINE_ASR_LANGUAGE=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# Optional server-readable key file, takes precedence over the environment key.
# VOLCENGINE_API_KEY_FILE=/app/data/secrets/volcengine-api-key
# Old-console credentials, only when no new API key is set:
# VOLCENGINE_APP_ID=
# VOLCENGINE_ACCESS_TOKEN=
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_RUN_IDLE_TIMEOUT_SECONDS=45

# Input preprocessing: ambiguous short speech is classified before any bubble/Run.
# Empty fields reuse the existing Agent model; point these at a faster compatible
# model independently when desired. Provider: openai (compatible API) or ollama.
INPUT_PREPROCESS_PROVIDER=
INPUT_PREPROCESS_MODEL=
INPUT_PREPROCESS_BASE_URL=
INPUT_PREPROCESS_API_KEY=
INPUT_PREPROCESS_TIMEOUT_SECONDS=6
